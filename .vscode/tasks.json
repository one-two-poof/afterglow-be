{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Server (bootRun)",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["bootRun", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "spring-boot",
        "pattern": ".",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Started AfterglowBeApplication"
        }
      }
    }
  ]
}
