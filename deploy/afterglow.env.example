# EC2 /opt/afterglow/afterglow.env 예시
# 이 파일은 Git에 올라갑니다. 실제 값은 EC2에만 두고 GitHub에는 올리지 마세요.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# RDS PostgreSQL (afterglow-db, ap-northeast-2, VPC 내부 전용)
SPRING_DATASOURCE_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/afterglow
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=afterglow_admin
SPRING_DATASOURCE_PASSWORD=

NOTION_API_TOKEN=
NOTION_DATABASE_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DATA_GO_KR_SERVICE_KEY=

JWT_SECRET=

# 관리자 전용 로그인 (/admin/login.html). 구글 로그인과 무관.
ADMIN_EMAIL=dunaduneo@gmail.com
ADMIN_PASSWORD=

# 구글 로그인 성공 후 리다이렉트할 프론트엔드(앱) 콜백 주소.
# 비워두면 코드 기본값(afterglow://oauth/callback)을 씀.
OAUTH_FRONTEND_REDIRECT_URL=afterglow://oauth/callback
