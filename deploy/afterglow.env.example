# EC2 /opt/afterglow/afterglow.env 예시
# 이 파일은 Git에 올라갑니다. 실제 값은 EC2에만 두고 GitHub에는 올리지 마세요.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:h2:file:/opt/afterglow/data/afterglow;MODE=PostgreSQL;AUTO_SERVER=TRUE
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

NOTION_API_TOKEN=
NOTION_DATABASE_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DATA_GO_KR_SERVICE_KEY=

JWT_SECRET=

# 구글 로그인 성공 후 리다이렉트할 프론트엔드 콜백 주소 (운영 도메인).
# 비워두면 코드 기본값(http://localhost:3000/oauth/callback)을 씀.
OAUTH_FRONTEND_REDIRECT_URL=https://after-glow.duckdns.org/oauth/callback
